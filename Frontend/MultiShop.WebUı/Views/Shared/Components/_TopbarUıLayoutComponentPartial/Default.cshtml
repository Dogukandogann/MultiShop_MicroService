<style>
    .topbar-exchange-rates {
        display: flex;
        justify-content: space-between;
        width: 100%; /* Full width of the container */
        align-items: center; /* Center align items vertically */
        margin-left:480px;
    }

        .topbar-exchange-rates p {
            margin: 0; /* Remove default margin */
            font-size: 14px; /* Adjust font size */
        }
        .topbar-exchange-rates .currency-label {
            font-size: 12px; /* Slightly smaller font size for labels */
            color: #6c757d; /* Light gray color for labels */
            font-style:bold;
        }
</style>

<div class="container-fluid">
    <div class="row align-items-center bg-light py-3 px-xl-5 d-none d-lg-flex">
        <div class="col-lg-4">
            <a href="" class="text-decoration-none">
                <span class="h1 text-uppercase text-primary bg-dark px-2">Multi</span>
                <span class="h1 text-uppercase text-dark bg-primary px-2 ml-n1">Shop</span>
            </a>
        </div>
        <div class="col-lg-4 col-6 text-left">
            <form action="">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Ürün ara">
                    <div class="input-group-append">
                        <span class="input-group-text bg-transparent text-primary">
                            <i class="fa fa-search"></i>
                        </span>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-lg-4 col-6 text-right">
            <p class="m-0">Müşteri Hizmetleri</p>
            <h5 class="m-0">+90 123 444 55 66</h5>
        </div>
        <div class="col-lg-4 col-6 text-right topbar-exchange-rates">
            <p class="m-0 currency-label">Dolar:@ViewBag.ExchangeUsd</p>
            <p class="m-0 currency-label">Euro:@ViewBag.ExchangeEur</p>
        </div>
    </div>
